# BranchMap 的 nginx 站点（服务器部署用）：把 branchmap.example.com 换成 config.json 里 auth.origin 的域名，
# 放进 /etc/nginx/conf.d/branchmap.conf，nginx -t 通过再 reload。独立一个文件，不碰机器上别的站点。
# 证书：certbot certonly --webroot -w /var/www/branchmap-acme -d <域名> --deploy-hook "systemctl reload nginx"
server {
    listen 80;
    listen [::]:80;
    server_name branchmap.example.com;
    location /.well-known/acme-challenge/ { root /var/www/branchmap-acme; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name branchmap.example.com;

    ssl_certificate     /etc/letsencrypt/live/branchmap.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/branchmap.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:branchmap_ssl:5m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    client_max_body_size 256k;

    location / {
        proxy_pass http://127.0.0.1:4317;
        proxy_http_version 1.1;
        proxy_set_header Host $host;                       # 服务只认 auth.origin 的域名，Host 必须原样转发
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
    # 实时推送（Server-Sent Events）：不缓冲、长连接
    location = /api/events {
        proxy_pass http://127.0.0.1:4317;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
    # GitHub App 的 Webhook：推送事件的请求体可能有几 MB（服务端上限 10 MB），靠签名认人
    location = /api/github/webhook {
        proxy_pass http://127.0.0.1:4317;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        client_max_body_size 10m;
    }
}
